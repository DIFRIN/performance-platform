# Docker build context exclusions (project root is the build context).
.git
.gitignore
.gitattributes
.idea/
.vscode/
*.iml
*.swp
*~

# Local Maven outputs (the image builds its own)
**/target/
*.class
*.jar

# Docker / CI / docs
.dockerignore
.github/
.gitlab-ci.yml
Jenkinsfile
*.md

# Local workspace tooling
.claude/
docs/
improvements.md

# Not needed by the platform image
distribution/examples/
distribution/kubernetes/

# Test sources are not needed in the image (mvn -DskipTests still compiles them)
**/src/test/
